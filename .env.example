# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# DECIZY CONFIGURATION (OPTIONAL FOR LOCAL DEV / SAFE DEMO MODE)
# If omitted, Decizy runs in safe local demonstration mode with seed data.
# ==============================================================================

# Supabase PostgreSQL & Authentication (Optional for local dev)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Selldone Genesis Commerce Integration (AnyRoomz Shop ID: 2906)
VITE_SELLDONE_SHOP_ID="2906"
VITE_SELLDONE_API_KEY="your-selldone-api-key-here"
